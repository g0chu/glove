# --- Discord ---------------------------------------------------------------

# Bot token (Developer Portal -> your app -> Bot -> Reset Token)
DISCORD_TOKEN=your-bot-token

# Reference only; not strictly needed at runtime (used e.g. for invite URLs).
DISCORD_APPLICATION_ID=

# The guild the bot acts in (Server Settings -> About Server -> ID).
# Leave empty to respond in any text channel of any guild the bot is in
# (DMs are never tracked).
DISCORD_GUILD_ID=

# A message is only committed to the channel context (and able to queue a
# turn) once it has been unchanged (no edits) for this long. Other bots
# stream their replies by posting a message and editing it as the text
# arrives; without this the model would see partial text (and a mention
# only in the final form would queue one turn per partial edit). A message
# deleted while still pending never enters the context. 0 commits on
# arrival (no waiting).
#
# The same value is the "quiet" window after a turn is interrupted by
# channel activity (a new message, an edit, or a typing indicator while the
# model is processing the prompt): the in-flight request is aborted, the
# partial reply is withdrawn, the bot waits this long for the channel to
# stay quiet (any new activity restarts the wait), then sends a fresh
# prompt carrying everything that arrived while it waited. It is also the
# "stillness" window of the chime (below): a chime decision waits for the
# channel to stay this long without any activity before the model decides.
DISCORD_MESSAGE_STABLE_MS=2000

# Chime: when true, any message that does NOT mention the bot (a human's or
# another bot's) still queues a turn in which the model decides — one small
# call over the channel's transcript, answered by calling the chime tool
# (respond + reason) — whether to respond at all. The decision happens over
# a still conversation: the bot first waits for complete stillness in the
# channel (no activity for DISCORD_MESSAGE_STABLE_MS — any new message,
# edit, or typing indicator cancels the pending decision and restarts the
# wait), and a newer message that lands while it waits supersedes the
# decision (its own turn decides), so a burst of messages settles into one
# decision over what was actually said. YES runs a normal turn (streamed
# reply like any mention); NO posts the decision + reason to the channel as
# a one-line UI message (never context). Mentions from any author always
# respond (no decision, no stillness wait).
BOT_CHIME_ENABLED=false

# Show NO decisions and their reasons in Discord. false keeps them in logs only.
BOT_CHIME_SHOW_NO=true

# Custom chime system prompt (empty = existing built-in prompt).
# Require one chime tool call with respond + reason; text decisions are rejected.
# Quote custom text; double-quoted values support \n and multiline text.
BOT_CHIME_PROMPT=

# Refresh interval (ms) for the typing indicator while the model is generating.
DISCORD_TYPING_INTERVAL_MS=5000

# Minimum gap (ms) between edits of the live (streaming) message.
DISCORD_STREAM_UPDATE_THROTTLE_MS=2000

# Show the model's streamed reasoning/thinking live ("🤔 *thinking: …*")
# while it is working out the answer. Only endpoints that stream reasoning
# deltas show anything. When the reply starts (with MODEL_STREAM=false,
# when it is ready), the preview completes into a "🤔 *thought for Ns*"
# line that stays above the reply (the reply streams in its own message);
# long thinking shows "N lines hidden" + the last 5 lines. The reasoning
# text itself is never posted or recorded.
DISCORD_SHOW_REASONING=true

# While a turn executes, show the tool activity in one shared message per
# turn (posted on the first call, edited in place for every later call —
# the channel stays quiet no matter how many calls run; when it would pass
# 2000 chars the oldest lines collapse into a "… N earlier calls …" header).
# Name + arguments only; tool results are never shown. These are bot
# messages and never enter the channel context.
DISCORD_SHOW_TOOL_ACTIVITY=true

# --- Model (any OpenAI-compatible Chat Completions endpoint) ----------------

MODEL_API_URL=http://localhost:8080/v1/chat/completions
MODEL_API_KEY=none
MODEL_NAME=local

# Image input: when true, image attachments (png/jpeg/webp/gif) in the
# channel's recent messages are downloaded and sent to the model as
# image_url content parts (base64 data URIs). The endpoint must support
# image input (a vision model). Attachments that cannot be sent (other
# types, over MODEL_IMAGES_MAX_BYTES, download failures) leave a one-line
# note in the model's context so it knows an attachment was not sent.
MODEL_ENABLE_IMAGES=false

# Max bytes per downloaded image; bigger attachments are skipped. Discord
# attachments top out at 10 MB without Nitro.
MODEL_IMAGES_MAX_BYTES=10485760

# File contents: when true, the text content of non-image attachments in
# the channel's recent messages is downloaded from Discord's CDN and
# inlined into the model's context as a labeled fenced block. Only readable
# text (valid UTF-8 without NUL bytes) is inlined; binary files, attachments
# over MODEL_FILE_CONTENT_MAX_BYTES, and download failures leave a one-line
# note instead. Image attachments stay the image pipeline's (MODEL_ENABLE_IMAGES):
# with this on, the image pipeline no longer notes non-image attachments as
# "unsupported type" (the file pipeline owns them).
MODEL_ENABLE_FILE_CONTENTS=false

# Max bytes per downloaded file; bigger attachments are skipped.
MODEL_FILE_CONTENT_MAX_BYTES=1000000

# true = stream SSE and edit the message live; false = single reply at the end.
MODEL_STREAM=true

# Optional system message prepended to every request (empty = none).
MODEL_SYSTEM_PROMPT=

# How many of the channel's last messages seed a channel's context when the
# bot first talks there after a start (also the window of messages whose
# image attachments are downloaded).
MODEL_CONTEXT_MAX_MESSAGES=20

# Context compaction. Each channel's context is seeded with its last
# MODEL_CONTEXT_MAX_MESSAGES messages when the bot first talks there, then
# only grows as new messages arrive (no message is lost). When the request
# size (the endpoint's measured prompt size when it reports usage, else the
# ~4-chars-per-token estimate) reaches CONTEXT_COMPACTION_MAX_TOKENS, the
# older part is replaced by a summary the model itself writes (one extra
# tool-less chat call at turn start, sent as a user message) and the newest
# CONTEXT_COMPACTION_KEEP_MESSAGES messages stay verbatim.

# Tokens at which the context compacts. Set a number to pin it (keep it
# comfortably below your llama-server context size, -c). Leave it EMPTY to
# have the bot set it automatically from the server's context window at
# startup (window minus the completion headroom — needs
# MODEL_METRICS_ENABLED=true; the default 4000 applies until the first
# successful probe). Either way, if a request still overfills the window the
# bot catches the endpoint's overflow rejection, drops the oldest messages
# (the triggering mention kept, the summary as a last resort) and retries the
# turn once.
CONTEXT_COMPACTION_MAX_TOKENS=

# How many of the newest messages survive a compaction verbatim.
CONTEXT_COMPACTION_KEEP_MESSAGES=20

# Custom compaction system prompt (empty = existing built-in prompt).
# Ask for a summary of the transcript, not answers to its questions.
# Quote custom text; double-quoted values support \n and multiline text.
# The summary is still capped at 4000 characters.
CONTEXT_COMPACTION_PROMPT=

# llama-server metrics: when true, the bot uses the model side's own
# tokenizer counts instead of the ~4-chars-per-token estimate where it can.
# The endpoint's reported usage (the usage/timings fields of the
# chat-completions response — llama-server sends both) is logged per turn
# (input + output tokens over all the turn's model calls), and the
# compaction trigger compares CONTEXT_COMPACTION_MAX_TOKENS against the
# measured prompt size instead of the estimate. The llama-server's /slots
# endpoint (same host as the chat endpoint by default) is probed after each
# turn: the current context state is logged ("server context X/Y tokens"),
# and when the endpoint reports no usage the slot's last-request token count
# is the fallback measurement. With CONTEXT_COMPACTION_MAX_TOKENS left empty,
# the startup probe also sets the compaction budget automatically (window
# minus the completion headroom). Off = estimates only (per-turn usage is
# still logged when the endpoint reports it).
MODEL_METRICS_ENABLED=false

# The llama-server base URL for the /slots probe. Default: the origin of
# MODEL_API_URL (llama-server serves /slots next to /v1/chat/completions).
# Set it when the model side lives on another host/port than the chat
# endpoint.
MODEL_METRICS_URL=

# Per /slots probe timeout, in ms.
MODEL_METRICS_TIMEOUT_MS=5000

# Per-request timeout in seconds (covers the whole stream).
MODEL_TIMEOUT_S=120

# Compactable working contexts. The archive below retains their original
# history, even after compaction, overflow trimming, edits, or !clear.
CHATS_FILE=./data/chats.json

# Durable append-only history: captured Discord messages/revisions, exact
# model requests and received response bytes, reasoning, tool execution
# starts/results, and downloaded attachment bytes. Enabled by default.
# !clear resets working context; it does NOT purge this archive.
# Archive writes are fsynced; failure stops the bot before further work.
# See ARCHIVE.md for inspection, export, recovery, and explicit purge.
CHATS_ARCHIVE_DIR=./data/archive

# --- Tools (all run in-process in the bot) -------------------------------
#
# All tool families are opt-in and need a model endpoint that supports
# function calling (tools). When disabled, the bot behaves exactly as before.

# Web tools: DuckDuckGo search + page fetch, run in-process in the bot
# (plain HTTP fetch with SSRF protection and content extraction; no browser
# rendering, so JavaScript-heavy pages may come back incomplete).
WEBTOOLS_ENABLED=false

# Per search/fetch call deadline, in seconds.
WEBTOOLS_TIMEOUT_S=90

# Max response body bytes kept from a fetch.
WEBTOOLS_FETCH_MAX_BYTES=5000000

# Max redirect hops per fetch.
WEBTOOLS_MAX_REDIRECTS=5

# Fetch-result cache: entry lifetime (seconds) and size cap (entries).
WEBTOOLS_CACHE_TTL_S=300
WEBTOOLS_CACHE_MAX_ENTRIES=256

# Hard cap on web_search results (the tool arg is clamped to this).
WEBTOOLS_SEARCH_MAX_RESULTS=10

# File tools: a persistent workspace the bot can read/write/edit.
# Runs in-process, confined to the workspace directory (paths that escape
# it, including via symlinks, are rejected). The directory survives restarts.
FILETOOLS_ENABLED=false
FILETOOLS_WORKSPACE=./workspace

# Max bytes returned by one file_read.
FILETOOLS_READ_MAX_BYTES=1000000

# Max bytes accepted by one file_write.
FILETOOLS_WRITE_MAX_BYTES=5000000

# Shell tool: run a shell command via /bin/sh in the file workspace
# (FILETOOLS_WORKSPACE), returning the exit code plus capped stdout and
# stderr. Use it for what the file tools cannot do: running programs, git,
# package managers, scripts. Commands are not sandboxed.
SHELLTOOLS_ENABLED=false

# Deadline per command, in seconds (also the cap for the tool's timeout_s
# argument).
SHELLTOOLS_TIMEOUT_S=30

# Max combined stdout+stderr bytes kept from one command; a chatty command
# is killed and the partial output is still returned.
SHELLTOOLS_MAX_OUTPUT_BYTES=100000

# Wikipedia tools: search/read articles from a local offline Wikipedia
# archive (a ZIM file on disk, e.g. the en.wikipedia "all nopic" dump in
# ./workspace). Runs in-process against the file directly. Note: reading
# Wikipedia ZIMs needs Node >= 22.15 (built-in zstd), since the article
# clusters are zstd-compressed.
ZIMTOOLS_ENABLED=false

# Path to the ZIM file (required when ZIMTOOLS_ENABLED=true).
ZIM_FILE=

# Hard cap on wikipedia_search results (the tool arg is clamped to this).
ZIMTOOLS_SEARCH_MAX_RESULTS=8

# Time budget (seconds) for a full-archive title scan. Exact and prefix
# matches use a fast binary search; only unusual spellings (or substring
# searches) fall back to this scan, so a small budget is usually enough.
ZIMTOOLS_SCAN_BUDGET_S=10

# Vault tools: search/read notes of a local offline Wikipedia vault of
# markdown notes (one flat note per article, built by the wiki2vault
# project; internal links are [[wikilinks]]). Runs in-process against the
# directory: note titles come from the vault's index.tsv (the directory
# listing when the index is not there yet), bodies via ripgrep when it is
# on PATH (a bounded pure-JS scan otherwise).
VAULTTOOLS_ENABLED=false

# Path to the vault directory (required when VAULTTOOLS_ENABLED=true).
VAULT_DIR=

# Hard cap on vault_search results (the tool arg is clamped to this).
VAULTTOOLS_SEARCH_MAX_RESULTS=8

# Time budget (seconds) for the title scan and for the body scan (a ripgrep
# body scan of the full vault takes longer than a title scan).
VAULTTOOLS_SCAN_BUDGET_S=10

# The ripgrep binary for the body scan (default "rg" from PATH). Point it at
# a static binary when ripgrep is not installed system-wide; a missing
# binary falls back to a bounded pure-JS scan.
#VAULTTOOLS_RG_PATH=/path/to/rg

# Hard cap on characters in one tool result (all families).
TOOLS_MAX_RESULT_CHARS=200000

# Max tool-execution rounds per turn before the turn is cut off.
TOOLS_MAX_ROUNDS=5
