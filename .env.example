# --- Discord ---------------------------------------------------------------

# Bot token (Developer Portal -> your app -> Bot -> Reset Token)
DISCORD_TOKEN=your-bot-token

# Reference only; not strictly needed at runtime (used e.g. for invite URLs).
DISCORD_APPLICATION_ID=

# The one guild the bot will act in (Server Settings -> About Server -> ID).
DISCORD_GUILD_ID=

# Refresh interval (ms) for the typing indicator while the model is generating.
DISCORD_TYPING_INTERVAL_MS=5000

# Minimum gap (ms) between edits of the live (streaming) message.
DISCORD_STREAM_UPDATE_THROTTLE_MS=2000

# --- Model (any OpenAI-compatible Chat Completions endpoint) ----------------

MODEL_API_URL=http://localhost:8080/v1/chat/completions
MODEL_API_KEY=none
MODEL_NAME=local

# Future: download channel attachments and send them as image_url content parts.
MODEL_ENABLE_IMAGES=false

# true = stream SSE and edit the message live; false = single reply at the end.
MODEL_STREAM=true

# Optional system message prepended to every request (empty = none).
MODEL_SYSTEM_PROMPT=

# Per-channel sliding window size (number of messages sent as history).
MODEL_CONTEXT_MAX_MESSAGES=20

# Per-request timeout in seconds (covers the whole stream).
MODEL_TIMEOUT_S=120

# --- Tools (both run in-process in the bot) ------------------------------
#
# Both tool families are opt-in and need a model endpoint that supports
# function calling (tools). When disabled, the bot behaves exactly as before.

# Web tools: DuckDuckGo search + page fetch, run in-process in the bot
# (plain HTTP fetch with SSRF protection and content extraction; no browser
# rendering, so JavaScript-heavy pages may come back incomplete).
WEBTOOLS_ENABLED=false

# Per search/fetch call deadline, in seconds.
WEBTOOLS_TIMEOUT_S=90

# Max response body bytes kept from a fetch.
WEBTOOLS_FETCH_MAX_BYTES=5000000

# Max redirect hops per fetch.
WEBTOOLS_MAX_REDIRECTS=5

# Fetch-result cache: entry lifetime (seconds) and size cap (entries).
WEBTOOLS_CACHE_TTL_S=300
WEBTOOLS_CACHE_MAX_ENTRIES=256

# Hard cap on web_search results (the tool arg is clamped to this).
WEBTOOLS_SEARCH_MAX_RESULTS=10

# File tools: a persistent workspace the bot can list/read/write/edit/search.
# Runs in-process, confined to the workspace directory (paths that escape
# it, including via symlinks, are rejected). The directory survives restarts.
FILETOOLS_ENABLED=false
FILETOOLS_WORKSPACE=./workspace

# Max bytes returned by one file_read.
FILETOOLS_READ_MAX_BYTES=1000000

# Max bytes accepted by one file_write.
FILETOOLS_WRITE_MAX_BYTES=5000000

# Max entries returned by one file_list.
FILETOOLS_LIST_MAX_ENTRIES=500

# Hard cap on file_search matches (the tool arg is clamped to this).
FILETOOLS_SEARCH_MAX_RESULTS=500

# Max files scanned by one file_search.
FILETOOLS_SEARCH_MAX_FILES=10000

# Max size (bytes) of a file file_search will open.
FILETOOLS_SEARCH_MAX_FILE_BYTES=5000000

# Max characters kept per matching search line.
FILETOOLS_LINE_MAX_CHARS=500

# Max tool-execution rounds per turn before the turn is cut off.
TOOLS_MAX_ROUNDS=5
